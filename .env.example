# Names only. Put real values in your shell or a local, uncommitted .env.

# Provider: set ONE of these. Never commit or print either.
# OpenRouter serves Meta's Muse Spark and Llama models and open-weight image models behind one key.
OPENROUTER_API_KEY=
# Meta Model API directly (https://api.meta.ai/v1).
MODEL_API_KEY=

# Which route to use when both keys are set: openrouter (free development models) or meta
# (Meta Model API, paid credits). The Meta route will not run without the three limits below.
ICARUS_PROVIDER=
ICARUS_DAILY_BUDGET_USD=
# Dollars per million tokens, from Meta's price list, so spend can be counted.
ICARUS_PRICE_IN_USD_PER_MTOK=
ICARUS_PRICE_OUT_USD_PER_MTOK=

# Optional. Language model slug (OpenRouter default is a free development model;
# set meta/muse-spark-1.3 for the submission). Image model slug for "Make it real".
ICARUS_MODEL=
ICARUS_IMAGE_MODEL=
OPENROUTER_BASE_URL=
META_BASE_URL=
